DB_NAME=umlforge_ai
DB_USER=umlforge
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=86400000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_GEMINI_TIMEOUT_SECONDS=45

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_GROQ_ENABLED=true
CHAT_GROQ_TIMEOUT_SECONDS=45

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_OPENROUTER_ENABLED=true
CHAT_OPENROUTER_TIMEOUT_SECONDS=45

OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_NUM_CTX=3072
OLLAMA_NUM_PREDICT=1200
OLLAMA_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE=10m
CHAT_OLLAMA_ENABLED=true
CHAT_OLLAMA_TIMEOUT_SECONDS=90
GEMINI_REQUEST_TIMEOUT_SECONDS=45
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
IMAGE_OLLAMA_MODEL=gemma3:4b
IMAGE_GEMINI_MODEL=gemini-3.5-flash-lite

HTTP_PORT=80
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Habilitar panel de credenciales de demo solo en desarrollo local (false en produccion)
VITE_ENABLE_DEMO_CREDENTIALS=false

# CU16 - Adjuntos privados del chat (10 MiB por archivo)
CHAT_ATTACHMENTS_MAX_FILE_BYTES=10485760
